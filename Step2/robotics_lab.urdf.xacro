<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="table">

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="table_macro.xacro" />
    <xacro:include filename="rrbot_macro.xacro" />

    <!-- Spacing between table centers -->
    <xacro:property name="spacing_x" value="5.0" />
    <xacro:property name="spacing_y" value="6.0" />
    <!-- Spacing between robots along a table's long (y) axis -->
    <xacro:property name="robot_spacing" value="1.2" />

    <link name="world" />

    <!-- One table with three robots on it -->
    <xacro:macro name="station" params="n x y">
        <xacro:table prefix="table${n}_" parent="world">
            <origin xyz="${x} ${y} 0" rpy="0 0 0" />
        </xacro:table>

        <xacro:rrbot prefix="table${n}_robot1_" parent="table${n}_top_link">
            <origin xyz="0 ${-robot_spacing} 0" rpy="0 0 0" />
        </xacro:rrbot>
        <xacro:rrbot prefix="table${n}_robot2_" parent="table${n}_top_link">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:rrbot>
        <xacro:rrbot prefix="table${n}_robot3_" parent="table${n}_top_link">
            <origin xyz="0 ${robot_spacing} 0" rpy="0 0 0" />
        </xacro:rrbot>
    </xacro:macro>

    <!-- 2x2 grid of stations -->
    <xacro:station n="1" x="${-spacing_x/2}" y="${-spacing_y/2}" />
    <xacro:station n="2" x="${spacing_x/2}"  y="${-spacing_y/2}" />
    <xacro:station n="3" x="${-spacing_x/2}" y="${spacing_y/2}" />
    <xacro:station n="4" x="${spacing_x/2}"  y="${spacing_y/2}" />

</robot>