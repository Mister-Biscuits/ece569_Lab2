<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="table">

  <xacro:include filename="common.xacro" />
  <xacro:include filename="table/table_macro.xacro" />

  <link name="world" />

  <xacro:table prefix="table_" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:table>

</robot>
