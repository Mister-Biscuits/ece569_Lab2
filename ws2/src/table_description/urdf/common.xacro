<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Prefixed names so they can't collide with materials from other packages -->
<material name="table_brown">
  <color rgba="0.55 0.35 0.15 1.0" />
</material>
<material name="table_grey">
  <color rgba="0.5 0.5 0.5 1.0" />
</material>

</robot>
