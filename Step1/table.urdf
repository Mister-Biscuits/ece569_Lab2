<?xml version="1.0"?>
<robot name="table">

<!-- define the colors -->
<material name="brown">
  <color rgba="0.54 0.27 0.07 1.0"/>
</material>
<material name="light_grey">
  <color rgba="0.8 0.8 0.8 1.0"/>
</material>

<!-- create link fixed to the "world" -->
<link name="world" />

<!-- Joint / Link Set -->
<!-- joint from "world" to "top"-->
<joint name="top" type="fixed">
  <origin rpy="0 0 0" xyz="0 0 1" />
  <parent link="world" />
  <child link="top_link" />
</joint>
  
<!-- Base Link -->
<link name="top_link">
  <visual>
    <origin rpy="0 0 0" xyz="0 0 0.025" />
    <geometry>
      <box size="2 1 .05" />
    </geometry>
    <material name="brown" />
  </visual>
</link>

<!-- Joint / Link Set -->s
<!-- joint from "top" to "leg1"-->
<joint name="leg1" type="fixed">
  <origin rpy="0 0 0" xyz="0.95 0.45 0" />
  <parent link="top_link" />
  <child link="leg1_link" />
</joint>
  
<!-- Leg1 Link -->
<link name="leg1_link">
  <visual>
    <origin rpy="0 0 0" xyz="0 0 -0.475" />
    <geometry>
      <cylinder length="0.95" radius="0.05"/>
    </geometry>
    <material name="light_grey" />
  </visual>
</link>

<!-- Joint / Link Set -->s
<!-- joint from "top" to "leg2"-->
<joint name="leg2" type="fixed">
  <origin rpy="0 0 0" xyz="-0.95 0.45 0" />
  <parent link="top_link" />
  <child link="leg2_link" />
</joint>
  
<!-- Leg2 Link -->
<link name="leg2_link">
  <visual>
    <origin rpy="0 0 0" xyz="0 0 -0.475" />
    <geometry>
      <cylinder length="0.95" radius="0.05"/>
    </geometry>
    <material name="light_grey" />
  </visual>
</link>

<!-- Joint / Link Set -->s
<!-- joint from "top" to "leg3"-->
<joint name="leg3" type="fixed">
  <origin rpy="0 0 0" xyz="0.95 -0.45 0" />
  <parent link="top_link" />
  <child link="leg3_link" />
</joint>
  
<!-- Leg3 Link -->
<link name="leg3_link">
  <visual>
    <origin rpy="0 0 0" xyz="0 0 -0.475" />
    <geometry>
      <cylinder length="0.95" radius="0.05"/>
    </geometry>
    <material name="light_grey" />
  </visual>
</link>

<!-- Joint / Link Set -->s
<!-- joint from "top" to "leg4"-->
<joint name="leg4" type="fixed">
  <origin rpy="0 0 0" xyz="-0.95 -0.45 0" />
  <parent link="top_link" />
  <child link="leg4_link" />
</joint>
  
<!-- Leg4 Link -->
<link name="leg4_link">
  <visual>
    <origin rpy="0 0 0" xyz="0 0 -0.475" />
    <geometry>
      <cylinder length="0.95" radius="0.05"/>
    </geometry>
    <material name="light_grey" />
  </visual>
</link>

</robot>